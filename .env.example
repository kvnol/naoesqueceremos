# URL pública do Google Forms de sugestões
NEXT_PUBLIC_SUGGEST_FORM_URL=https://docs.google.com/forms/d/e/XXXX/viewform

# IDs dos campos do Forms para pré-preenchimento (opcional)
# Inspecione o HTML do formulário: name="entry.123456789"
NEXT_PUBLIC_FORM_ENTRY_UF=entry.111111111
NEXT_PUBLIC_FORM_ENTRY_TIPO=entry.222222222

# CSV da aba "publicados" (somente servidor — nunca NEXT_PUBLIC_)
# Arquivo → Compartilhar → Publicar na Web → CSV
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv

# Segredo para POST /api/revalidate após aprovar itens
REVALIDATE_SECRET=troque-por-um-segredo-longo

# Opcional: URL canônica do site (SEO / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app
